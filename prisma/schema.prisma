generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetOTP {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
}

model RegistrationOTP {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  otpHash      String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model Part {
  id           String    @id @default(uuid())
  partNumber   String
  title        String
  range        String
  articles     Int
  description  String?
  createdAt    DateTime  @default(now())
  articlesList Article[]
}

model Article {
  id                String   @id @default(uuid())
  articleNumber     String
  title             String
  shortSummary      String?
  officialText      String?
  simpleExplanation String?
  example           String?
  tags              String?
  featured          Boolean  @default(false)
  partId            String
  createdAt         DateTime @default(now())
  part              Part     @relation(fields: [partId], references: [id])
  clauses           Clause[]
}

model Clause {
  id           String   @id @default(uuid())
  clauseNumber String
  text         String
  createdAt    DateTime @default(now())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Preamble {
  id                String   @id @default("singleton")
  officialText      String
  simpleExplanation String
  whyItMatters      String
  keywords          String   @default("[]")
  timeline          String   @default("[]")
  quickFacts        String   @default("[]")
  updatedAt         DateTime @updatedAt
  landmarkCases     String   @default("[]")
  notes             String   @default("[]")
}

model Schedule {
  id          String   @id @default(uuid())
  shortId     String
  schedule    String
  title       String
  description String?
  topics      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  tagDetails  String   @default("[]")
}

model Amendment {
  id              String   @id @default(uuid())
  number          String
  year            String
  title           String
  summary         String
  whyItMatters    String?
  relatedArticles String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Quiz {
  id          String            @id @default(uuid())
  title       String
  level       String
  status      String            @default("draft")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  description String?
  timeMinutes Int               @default(10)
  questions   Question[]
  attempts    UserQuizAttempt[]
}

model Question {
  id            String   @id @default(uuid())
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model UserQuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  totalQ      Int
  answers     String
  submittedAt DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String
  rating     Int
  name       String?
  comment    String?
  createdAt  DateTime @default(now())
  showOnSite Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String         @id @default(cuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  visitorId String?
  ipAddress String?
  userAgent String?
  source    String?
  visitedAt DateTime @default(now())

  @@index([visitedAt])
  @@index([source])
}

model TrafficSource {
  id        String   @id @default(uuid())
  name      String
  value     Int
  createdAt DateTime @default(now())
}

model DailyAnalytics {
  id        String   @id @default(uuid())
  date      DateTime @unique
  dau       Int
  mau       Int
  createdAt DateTime @default(now())

  @@index([date])
}

model Conversation {
  id String @id @default(uuid())
  title String?
  userId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages ChatMessage[]
  user User? @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id String @id @default(uuid())
  role String
  content String
  createdAt DateTime @default(now())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model ChatbotQuery {
  id        String   @id @default(uuid())
  category  String
  resolved  Boolean  @default(false)
  question  String?
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id          String        @id @default(uuid())
  actorId     String?
  actorEmail  String?
  actorName   String?
  actorRole   Role?
  action      String
  description String?
  scope       AuditScope
  severity    AuditSeverity @default(INFO)
  entityType  String
  entityId    String?
  entityLabel String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  actor       User?         @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([scope])
  @@index([severity])
  @@index([actorId])
  @@index([entityType])
}

model Alert {
  id             String                @id @default(uuid())
  status         AlertStatus           @default(OPEN)
  severity       AlertSeverity         @default(MEDIUM)
  title          String
  description    String
  serviceName    String
  serviceIcon    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  metrics        AlertCategoryMetric[]
  categories     AlertCategory[]       @relation("AlertToAlertCategory")

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model AlertCategory {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  color       String
  metrics     AlertCategoryMetric[]
  alerts      Alert[]               @relation("AlertToAlertCategory")
}

model AlertCategoryMetric {
  id         String        @id @default(uuid())
  alertId    String
  categoryId String
  count      Int
  total      Int
  date       DateTime      @default(now())
  alert      Alert         @relation(fields: [alertId], references: [id], onDelete: Cascade)
  category   AlertCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([alertId, categoryId, date])
  @@index([categoryId])
  @@index([date])
}

model AlertFrequencyMetric {
  id             String   @id @default(uuid())
  hour           Int
  date           DateTime
  totalAlerts    Int
  criticalAlerts Int
  createdAt      DateTime @default(now())

  @@unique([hour, date])
  @@index([date])
}

model AlertHistoricalMetric {
  id            String   @id @default(uuid())
  date          DateTime @unique
  openedCount   Int
  resolvedCount Int
  createdAt     DateTime @default(now())
}

model AlertHeatmapMetric {
  id         String   @id @default(uuid())
  dayOfWeek  Int
  hour       Int
  alertCount Int
  date       DateTime @default(now())

  @@unique([dayOfWeek, hour, date])
  @@index([date])
}

model User {
  id                  String               @id @default(uuid())
  name                String?
  email               String               @unique
  password            String
  role                Role                 @default(USER)
  status              Status               @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  avatar              String?
  lastLogin           DateTime?
  isDeleted           Boolean              @default(false)
  auditLogs           AuditLog[]
  feedbacks           Feedback[]
  passwordResetTokens PasswordResetToken[]
  posts               Post[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  quizAttempts        UserQuizAttempt[]
  conversations       Conversation[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model SecurityRiskAssessment {
  id            String           @id @default(uuid())
  userId        String?
  emailHash     String?
  ipAddress     String?
  country       String?
  deviceId      String?
  userAgent     String?
  riskScore     Int
  trustScore    Int
  decision      SecurityDecision
  signals       Json
  behaviorScore Int              @default(0)
  modelVersion  String           @default("cyberguard-v4.2")
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([decision])
  @@index([createdAt])
}

model BehavioralProfile {
  id             String   @id @default(uuid())
  userId         String
  deviceId       String?
  baseline       Json
  sampleCount    Int      @default(0)
  anomalyScore   Int      @default(0)
  classification String   @default("human")
  lastObservedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([anomalyScore])
  @@index([lastObservedAt])
}

model JwtRevocation {
  id          String   @id @default(uuid())
  jti         String   @unique
  userId      String?
  sessionId   String?
  deviceId    String?
  reason      String
  revokedById String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model DeviceTrust {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String
  trustScore    Int       @default(50)
  userAgentHash String?
  ipPrefix      String?
  country       String?
  lastSeenAt    DateTime  @default(now())
  trustedUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, deviceId])
  @@index([trustScore])
  @@index([lastSeenAt])
}

model PiiVaultRecord {
  id             String    @id @default(uuid())
  ownerType      String
  ownerId        String
  fieldName      String
  encryptedValue String
  maskedValue    String
  keyVersion     String
  lastAccessedBy String?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([ownerType, ownerId, fieldName])
  @@index([maskedValue])
  @@index([lastAccessedAt])
}

model RateLimitEvent {
  id           String    @id @default(uuid())
  key          String
  ipAddress    String?
  userId       String?
  endpoint     String?
  attempts     Int
  delayMs      Int       @default(0)
  blockedUntil DateTime?
  fingerprint  String?
  createdAt    DateTime  @default(now())

  @@index([key])
  @@index([ipAddress])
  @@index([blockedUntil])
  @@index([createdAt])
}

model ThreatIntelligenceEvent {
  id          String        @id @default(uuid())
  type        ThreatType
  severity    AlertSeverity
  confidence  Int
  ipAddress   String?
  country     String?
  endpoint    String?
  payloadHash String?
  prediction  Json?
  mitigated   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([type])
  @@index([severity])
  @@index([ipAddress])
  @@index([createdAt])
}

model SecurityIncident {
  id              String        @id @default(uuid())
  incidentNumber  String        @unique
  title           String
  severity        AlertSeverity
  status          String        @default("Investigating")
  rootCause       Json?
  timeline        Json          @default("[]")
  recoveryPercent Int           @default(0)
  openedAt        DateTime      @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([severity])
  @@index([status])
  @@index([openedAt])
}

enum AuditScope {
  IAM
  SECURITY
  DATABASE
  CONTENT
  SETTINGS
  SYSTEM
}

enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKED
  DISMISSED
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum SecurityDecision {
  ALLOW
  OTP
  BLOCK
}

enum SecurityEventType {
  RBA
  BEHAVIORAL_BIOMETRICS
  JWT_REVOCATION
  PII_VAULT
  RATE_LIMIT
  TARPIT
  SOC_ALERT
  THREAT_INTEL
}

enum ThreatType {
  SQL_INJECTION
  XSS
  CREDENTIAL_STUFFING
  SESSION_HIJACKING
  OTP_ABUSE
  API_SCRAPING
  BOT_SWARM
  GEO_ANOMALY
  DEVICE_MISMATCH
}
